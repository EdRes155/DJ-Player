# ============ SPOTIFY ============
# Crea tu app en https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:5173/callback (dev) y https://TU-APP.vercel.app/callback (prod)
VITE_SPOTIFY_CLIENT_ID=tu_client_id_aqui
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# ============ ELEVENLABS (voz del DJ) — SOLO SERVIDOR ============
# ¡Sin prefijo VITE_! Las variables VITE_* se incrustan en el JavaScript
# público. Estas solo las lee la función api/tts.js en Vercel.
# Crea la key en https://elevenlabs.io -> Developers -> API Keys
# (restríngela a "Text to Speech" y ponle un límite de créditos).
ELEVENLABS_API_KEY=
# Voice Library -> elige una voz en español -> copia su Voice ID
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (estable, natural) | eleven_v3 (más expresiva)
# | eleven_flash_v2_5 (más rápida y barata)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Tu id de usuario de Spotify (separados por coma si son varios).
# Solo esas cuentas pueden gastar tus créditos de ElevenLabs.
ALLOWED_SPOTIFY_USERS=
# Opcional: peticiones de voz por usuario cada 10 minutos (por defecto 60)
TTS_RATE_LIMIT=
# Opcional: orígenes extra autorizados (p. ej. la app de Electron)
TTS_ALLOWED_ORIGINS=

# Solo para Electron: URL absoluta del backend de voz
# VITE_TTS_ENDPOINT=https://dj-player-mu.vercel.app/api/tts

# ============ OPCIONAL: LLM para guiones del DJ ============
# Si lo dejas vacío, el DJ usa el generador de guiones local (djScript.js)
VITE_LLM_API_URL=

# ============ VOZ DEL DJ ============
# auto = ElevenLabs (vía /api/tts) y, si falla, la voz del navegador. RECOMENDADO.
# local = siempre navegador (gratis, sin key, español nativo)
# elevenlabs = solo ElevenLabs (si falla, el DJ no habla)
VITE_TTS_PROVIDER=auto
